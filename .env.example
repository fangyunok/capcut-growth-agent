# Template only. No real API key, SSH address, or user credential is included.
# The Python CLI reads process environment variables; it does not auto-load .env.
# Docker supports: docker run --env-file .env ...

# Default open-weight model endpoint. In Docker use host.docker.internal instead
# of 127.0.0.1 when Ollama runs on the host.
GROWTH_QWEN_BASE=http://127.0.0.1:11434/v1
GROWTH_QWEN_MODEL=qwen3:4b-instruct
GROWTH_QWEN_TIMEOUT=900

# Optional Chat Completions-compatible service for CLI --mode api.
# Set a real base URL/model locally; leave the key empty in version control.
GROWTH_API_BASE=
GROWTH_MODEL=
GROWTH_API_KEY=

# Optional file and output overrides. Uncomment and supply existing paths.
# GROWTH_AUDIT_KNOWLEDGE=/absolute/path/to/my_knowledge.json
# GROWTH_AUDIT_RULES=/absolute/path/to/my_rules.json
# GROWTH_RUNS_DIR=/absolute/path/to/runs
# GROWTH_FFMPEG=/absolute/path/to/ffmpeg
# GROWTH_FONT_PATH=/absolute/path/to/font.ttf
